{
  "name": "watari-monorepo",
  "private": true,
  "description": "Pure-JS data fetching for React / React Native: middleware pipeline + tag-based cache with pluggable stores.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dangttp97/watari.git"
  },
  "author": "Trần Thành Phương Đăng (https://github.com/dangttp97)",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "packageManager": "yarn@4.11.0",
  "scripts": {
    "prepack": "bob build",
    "example:native": "yarn workspace watari-example-native",
    "example:web": "yarn workspace watari-example-web",
    "build": "yarn workspaces foreach -Apt --include \"@watari/*\" run build",
    "clean": "yarn workspaces foreach -Ap --include \"@watari/*\" run clean",
    "prepare": "yarn build",
    "typecheck": "tsc && yarn example:web typecheck",
    "test": "jest --passWithNoTests",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "format": "prettier --write \"**/*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{json,md,yml,yaml}\"",
    "release": "release-it --only-version"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/eslint-config": "0.81.5",
    "@release-it/conventional-changelog": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lefthook": "^2.0.3",
    "prettier": "^3.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.40.17",
    "release-it": "^19.0.4",
    "typescript": "^5.9.2"
  },
  "jest": {
    "moduleNameMapper": {
      "^@watari/(.*)$": "<rootDir>/packages/$1/src"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/examples/",
      "<rootDir>/packages/.*/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
